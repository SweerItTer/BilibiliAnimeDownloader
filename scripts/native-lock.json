{
  "schema_version": 1,
  "name": "FFmpeg",
  "version": "8.0.3",
  "url": "https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz",
  "sha256": "6136812ea6d4e68bdba27e33c2a94382711cdf4f8602ffef056ff792bd6f9818",
  "archive": "ffmpeg-8.0.3.tar.xz",
  "license": "LGPL-2.1-or-later",
  "configure": [
    "--disable-everything",
    "--disable-autodetect",
    "--disable-static",
    "--enable-shared",
    "--disable-programs",
    "--disable-doc",
    "--disable-network",
    "--disable-avdevice",
    "--disable-avfilter",
    "--disable-swscale",
    "--disable-swresample",
    "--disable-gpl",
    "--disable-nonfree",
    "--disable-version3",
    "--enable-avformat",
    "--enable-avcodec",
    "--enable-avutil",
    "--enable-protocol=file",
    "--enable-demuxer=mov,flv,concat,aac,mp3,flac,ac3,eac3",
    "--enable-muxer=mp4",
    "--enable-parser=h264,hevc,av1,aac,aac_latm,mpegaudio,flac,ac3",
    "--enable-bsf=aac_adtstoasc,h264_mp4toannexb,hevc_mp4toannexb,extract_extradata,av1_frame_merge,vp9_superframe_split",
    "--enable-decoder=h264,hevc,aac,mp3,flac,ac3,eac3,flv"
  ]
}
